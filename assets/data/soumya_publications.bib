        pages = {1290-1291},
          doi = {10.1063/1.4810714},
       adsurl = {https://ui.adsabs.harvard.edu/abs/2013AIPC.1536.1290S},
      adsnote = {Provided by the SAO/NASA Astrophysics Data System},
      citation_count = {3},
      abstract = {The compact plasma system(CPS) at Ravenshaw University, India consists of a curved vacuum chamber which is nothing but a part of a toroid. To produce plasma a gas injected washer stacked plasma gun is designed and tested. The pulse forming network (PFN) is designed to energize the gun. It is of Guillemin E type which consists of capacitors having equal capacitance 5.5 μF and inductors having equal inductances 1.5 μH. The pulse width of the PFN is ∼ 7.6 μs for a seven stage network, as tested with known resistive circuit.}
